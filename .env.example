# Organisers and their codes, as Name:code pairs (spec 8.2, O-8). Codes 12+ chars, no ':' or ','.
ADMIN_CODES=Gabriel:change-me-12345,Steve:change-me-67890

# Postgres connection string. In production this is the Supabase pooler URL
# (Project settings -> Database -> Connection string, "Transaction" mode, port 6543).
# Leave it unset locally and the app runs on an embedded PGlite database under .data/.
DATABASE_URL=

# Any random string. Sent by the Netlify scheduled function to /api/cron/ping (spec 7.7).
CRON_SECRET=change-me
